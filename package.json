{
  "name": "scripts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "build": "bun run --filter '@scripts/eimer' build",
    "build:all": "bun run --filter '@scripts/eimer' --filter '@scripts/pr' --filter '@scripts/pipeline' --filter '@scripts/release' --filter '@scripts/task' build",
    "dev": "bun run packages/eimer/src/index.ts",
    "doctor": "bun run packages/eimer/src/index.ts doctor",
    "generate": "bun run --filter '@scripts/*' generate",
    "typecheck": "bun run --filter '@scripts/*' typecheck",
    "test": "bun run --filter '@scripts/*' test",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "helpers:collect-music": "bun run --filter '@scripts/helpers' collect-music",
    "helpers:tag-music": "bun run --filter '@scripts/helpers' tag-music"
  },
  "trustedDependencies": [
    "bun"
  ],
  "overrides": {
    "@opentui/core": "0.1.97",
    "@opentui/react": "0.1.97"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0"
  }
}
