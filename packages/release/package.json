{
  "name": "@scripts/release",
  "version": "0.5.2",
  "type": "module",
  "description": "A CLI for release workflows",
  "author": "",
  "exports": {
    ".": "./src/index.ts",
    "./commands": "./src/commands/index.ts",
    "./config": "./src/config.ts"
  },
  "bin": {
    "release": "./dist/index.js"
  },
  "scripts": {
    "generate": "bunli generate",
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --minify --outfile ../../bin/release",
    "build:publish": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bunli/core": "0.9.1",
    "@scripts/ui": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bunli/test": "0.6.0",
    "@types/bun": "latest",
    "bunli": "0.9.1",
    "typescript": "^5.0.0"
  },
  "bunli": {
    "entry": "./src/index.ts",
    "outDir": "./dist"
  }
}
